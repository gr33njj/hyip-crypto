# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/webhook/telegram
TELEGRAM_SECRET_TOKEN=random_secret_for_webhook_security

# Admin Configuration  
ADMIN_TELEGRAM_IDS=123456789,987654321
WEBAPP_URL=https://your-domain.com
ADMIN_URL=https://admin.your-domain.com

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/usdt_deposits
DB_HOST=localhost
DB_PORT=5432
DB_NAME=usdt_deposits
DB_USER=username
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/webhook/telegram
TELEGRAM_SECRET_TOKEN=your-webhook-secret-token

# Tron Network Configuration
TRON_NETWORK=shasta  # mainnet, shasta (testnet), nile (testnet)
TRON_API_KEY=your-tron-api-key
TRON_FULL_NODE=https://api.shasta.trongrid.io
TRON_SOLIDITY_NODE=https://api.shasta.trongrid.io
TRON_EVENT_SERVER=https://api.shasta.trongrid.io

# USDT Contract Configuration
USDT_CONTRACT_ADDRESS=TG3XXyExBkPp9nzdajDZsozEu4BkaSJozs  # Shasta testnet
POOL_WALLET_ADDRESS=your-pool-wallet-address
HOT_WALLET_ADDRESS=your-hot-wallet-address

# Security Configuration
CONFIRMATIONS_THRESHOLD=20
MIN_DEPOSIT_AMOUNT=10
MAX_WITHDRAWAL_AMOUNT=10000
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Vault Configuration (for production)
VAULT_URL=http://localhost:8200
VAULT_TOKEN=your-vault-token
VAULT_SECRET_PATH=secret/usdt-app

# Monitoring
PROMETHEUS_PORT=9090
LOG_LEVEL=info

# Admin Configuration
ADMIN_PANEL_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-telegram-app.com

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@yourdomain.com
