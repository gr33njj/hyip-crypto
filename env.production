# Production Environment Configuration
# ВАЖНО: Измените все значения на реальные!

# Основные настройки
NODE_ENV=production
DOMAIN=your-domain.com

# База данных
DB_NAME=usdt_deposits
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_456!

# JWT и безопасность
JWT_SECRET=CHANGE_THIS_VERY_STRONG_JWT_SECRET_789!
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD_012!

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/webhook/telegram
TELEGRAM_SECRET_TOKEN=YOUR_WEBHOOK_SECRET_TOKEN

# TRON настройки
TRON_NETWORK=mainnet
POOL_WALLET_ADDRESS=YOUR_POOL_TRON_ADDRESS
HOT_WALLET_ADDRESS=YOUR_HOT_WALLET_ADDRESS
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_API_KEY=YOUR_TRON_API_KEY

# URLs для frontend/admin
FRONTEND_API_URL=https://your-domain.com/api/v1
ADMIN_API_URL=https://your-domain.com/api/v1
CORS_ORIGINS=https://your-domain.com,https://t.me

# SSL Email (для Let's Encrypt)
SSL_EMAIL=your-email@domain.com
